<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Ejemplo de LaunchAgent — adaptá las rutas a tu máquina.
  Instalar: cp com.ainoch.notch.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/501 ~/Library/LaunchAgents/com.ainoch.notch.plist
-->
<dict>
    <key>Label</key>
    <string>com.ainoch.notch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/ABS/PATH/TO/ainoch</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/ainoch.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ainoch.err.log</string>
</dict>
</plist>
